rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // HELPER FUNCTIONS & AUTHENTICATION ABSTRACTION
    // ----------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return isSignedIn() && userDocExists()
        ? getUserDoc().role
        : 'guest';
    }

    function isAdminBootstrapEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kirengacargo@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        // The bootstrap emails may create their first admin profile.
        isAdminBootstrapEmail() && !userDocExists()
        ||
        // Once a profile exists, the Firestore role AND active status are authoritative.
        (userDocExists() &&
          (getUserRole() == 'admin' || getUserRole() == 'ADMIN') &&
          (getUserDoc().status == 'active' || getUserDoc().status == 'ACTIVE'))
      );
    }

    function isWorker() {
      return isSignedIn() && isActive() &&
        (getUserRole() == 'worker' || getUserRole() == 'WORKER' ||
         getUserRole() == 'staff' || getUserRole() == 'STAFF' || isAdmin());
    }

    function isDriver() {
      return isSignedIn() && isActive() &&
        (getUserRole() == 'driver' || getUserRole() == 'DRIVER' || isAdmin());
    }

    function isCustomer() {
      return isSignedIn() && isActive() &&
        (getUserRole() == 'customer' || getUserRole() == 'CUSTOMER');
    }

    function isActive() {
      return isSignedIn() && userDocExists() && (getUserDoc().status == 'active' || getUserDoc().status == 'ACTIVE');
    }

    function hasValidTimestamps() {
      return request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
    }

    function stringWithin(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isValidBooking(bookingId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'bookingReference', 'status', 'fullName', 'phone', 'email',
          'pickupCountry', 'pickupLocation', 'deliveryCountry', 'deliveryLocation',
          'cargoType', 'cargoDescription', 'weightKg', 'quantity', 'dimensions',
          'pickupDate', 'deliveryRequirements', 'specialInstructions',
          'documentName', 'documentData', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'id', 'bookingReference', 'status', 'fullName', 'phone', 'email',
          'pickupCountry', 'pickupLocation', 'deliveryCountry', 'deliveryLocation',
          'cargoType', 'cargoDescription', 'weightKg', 'quantity',
          'createdAt', 'updatedAt'
        ])
        && d.id == bookingId
        && d.status == 'PENDING'
        && stringWithin(d.fullName, 120)
        && stringWithin(d.phone, 40)
        && stringWithin(d.email, 254)
        && d.email.matches('.*@.*')
        && stringWithin(d.pickupCountry, 80)
        && stringWithin(d.pickupLocation, 240)
        && stringWithin(d.deliveryCountry, 80)
        && stringWithin(d.deliveryLocation, 240)
        && stringWithin(d.cargoType, 80)
        && stringWithin(d.cargoDescription, 1000)
        && d.weightKg is number && d.weightKg > 0 && d.weightKg <= 100000
        && d.quantity is int && d.quantity > 0 && d.quantity <= 10000
        && (!('dimensions' in d) || d.dimensions is string && d.dimensions.size() <= 120)
        && (!('pickupDate' in d) || d.pickupDate is string && d.pickupDate.size() <= 40)
        && (!('deliveryRequirements' in d) || d.deliveryRequirements is string && d.deliveryRequirements.size() <= 1000)
        && (!('specialInstructions' in d) || d.specialInstructions is string && d.specialInstructions.size() <= 1000)
        && (!('documentName' in d) || d.documentName is string && d.documentName.size() <= 120)
        && (!('documentData' in d) || d.documentData is string && d.documentData.size() <= 700000)
        && hasValidTimestamps();
    }

    function isValidQuote(quoteId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'quoteReference', 'customerName', 'customerEmail', 'customerPhone',
          'origin', 'destination', 'cargoType', 'weightKg', 'transportCost',
          'additionalCharges', 'taxes', 'total', 'currency', 'validUntil',
          'terms', 'status', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'id', 'quoteReference', 'customerName', 'customerEmail', 'customerPhone',
          'origin', 'destination', 'cargoType', 'weightKg', 'transportCost',
          'additionalCharges', 'taxes', 'total', 'currency', 'validUntil',
          'terms', 'status', 'createdAt', 'updatedAt'
        ])
        && d.id == quoteId
        && d.status == 'SENT'
        && stringWithin(d.quoteReference, 80)
        && stringWithin(d.customerName, 120)
        && stringWithin(d.customerEmail, 254)
        && d.customerEmail.matches('.*@.*')
        && stringWithin(d.customerPhone, 40)
        && stringWithin(d.origin, 240)
        && stringWithin(d.destination, 240)
        && stringWithin(d.cargoType, 80)
        && d.weightKg is number && d.weightKg > 0 && d.weightKg <= 100000
        && d.transportCost is number && d.transportCost >= 0
        && d.additionalCharges is number && d.additionalCharges >= 0
        && d.taxes is number && d.taxes >= 0
        && d.total is number && d.total >= 0
        && stringWithin(d.currency, 8)
        && stringWithin(d.validUntil, 40)
        && stringWithin(d.terms, 1000)
        && hasValidTimestamps();
    }

    function isValidPublicTracking(trackingNumber) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'shipmentNumber', 'status', 'originCountry', 'originCity',
          'destinationCountry', 'destinationCity', 'cargoType', 'weightKg',
          'pickupDate', 'expectedDelivery', 'actualDelivery', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'id', 'shipmentNumber', 'status', 'originCountry', 'originCity',
          'destinationCountry', 'destinationCity', 'cargoType', 'weightKg',
          'createdAt', 'updatedAt'
        ])
        && d.id == trackingNumber
        && d.shipmentNumber == trackingNumber
        && stringWithin(d.status, 40)
        && stringWithin(d.originCountry, 80)
        && stringWithin(d.originCity, 120)
        && stringWithin(d.destinationCountry, 80)
        && stringWithin(d.destinationCity, 120)
        && stringWithin(d.cargoType, 80)
        && d.weightKg is number && d.weightKg >= 0 && d.weightKg <= 100000
        && (!('pickupDate' in d) || d.pickupDate is string && d.pickupDate.size() <= 40)
        && (!('expectedDelivery' in d) || d.expectedDelivery is string && d.expectedDelivery.size() <= 40)
        && (!('actualDelivery' in d) || d.actualDelivery is string && d.actualDelivery.size() <= 40)
        && hasValidTimestamps();
    }

    // Default: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // USERS (Admin-created accounts + Initial Bootstrap)
    // ----------------------------------------------------
    
    match /users/{userId} {
      // Users can read own profile; Admin can read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // Creation: Only Admin, or the initial bootstrap admin account
      allow create: if (isAdmin() && userDocExists() && hasValidTimestamps()
            && (request.resource.data.role == 'admin' || request.resource.data.role == 'ADMIN'
                || request.resource.data.role == 'staff' || request.resource.data.role == 'STAFF'
                || request.resource.data.role == 'worker' || request.resource.data.role == 'WORKER'
                || request.resource.data.role == 'driver' || request.resource.data.role == 'DRIVER'))
        || (isSignedIn()
            && request.auth.uid == userId
            && isAdminBootstrapEmail()
            && !userDocExists()
            && request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email
            && isAdminBootstrapEmail()
            && (request.resource.data.role == 'admin' || request.resource.data.role == 'ADMIN')
            && (request.resource.data.status == 'active' || request.resource.data.status == 'ACTIVE')
            && hasValidTimestamps())
        || (isOwner(userId)
            && request.auth.token.email_verified == true
            && request.resource.data.keys().hasOnly([
              'id', 'uid', 'fullName', 'username', 'email', 'role', 'status', 'customerId',
              'mustChangePassword', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'id', 'uid', 'fullName', 'email', 'role', 'status', 'customerId',
              'mustChangePassword', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.id == userId
            && request.resource.data.uid == userId
            && request.resource.data.customerId == userId
            && request.resource.data.role == 'CUSTOMER'
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.mustChangePassword == false
            && request.resource.data.email == request.auth.token.email
            && (!('username' in request.resource.data) || request.resource.data.username is string && request.resource.data.username.size() <= 80)
            && stringWithin(request.resource.data.fullName, 120)
            && hasValidTimestamps());

      // Update: Admin can update any field; User can update non-sensitive profile fields or complete password change
      allow update: if (isAdmin() && hasValidTimestamps())
        || (isOwner(userId) && isCustomer()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt'])
            && (!('phone' in request.resource.data) || request.resource.data.phone is string && request.resource.data.phone.size() <= 40)
            && hasValidTimestamps())
        || (isOwner(userId)
            && (isActive() || request.resource.data.mustChangePassword == false)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.department == resource.data.department
            && request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.createdBy == resource.data.createdBy
            && hasValidTimestamps());

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // DEPARTMENTS (Configured by Admin)
    // ----------------------------------------------------
    
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // DRIVERS DIRECTORY
    // ----------------------------------------------------
    
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (isAdmin() || isWorker() || (resource.data.userId == request.auth.uid));
      allow write: if isAdmin() && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // FLEET VEHICLES & TRAILERS
    // ----------------------------------------------------
    
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /trailers/{trailerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /maintenance/{maintenanceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /fuelRecords/{fuelId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isDriver()) && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // CLIENTS & COMMERCIAL
    // ----------------------------------------------------
    
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /bookings/{bookingId} {
      // Booking records contain customer contact details and are staff-only.
      allow read: if isSignedIn() && isActive() && (isAdmin() || isWorker());
      allow create: if isValidBooking(bookingId);
      allow update: if isSignedIn() && isActive() && (isAdmin() || isWorker()) && hasValidTimestamps();
      allow delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isSignedIn() && isActive() && (
        isAdmin() || isWorker() ||
        (isCustomer() && resource.data.customerEmail == request.auth.token.email)
      );
      allow create: if isValidQuote(quoteId);
      allow update: if (isSignedIn() && isActive() && (isAdmin() || isWorker()) && hasValidTimestamps())
        || (isCustomer()
          && resource.data.customerEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['ACCEPTED', 'REJECTED']
          && hasValidTimestamps());
      allow delete: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (isAdmin() || isWorker()
        || (isCustomer() && resource.data.customerEmail == request.auth.token.email));
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isAdmin() || isWorker()
        || (isCustomer() && resource.data.customerEmail == request.auth.token.email));
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || isWorker()
        || (isCustomer() && resource.data.requesterId == request.auth.uid);
      allow create: if isCustomer()
        && request.resource.data.keys().hasOnly([
          'id', 'ticketNumber', 'requesterName', 'requesterRole', 'requesterId',
          'subject', 'category', 'description', 'relatedShipmentNumber',
          'status', 'urgency', 'createdAt', 'updatedAt', 'messages'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'ticketNumber', 'requesterName', 'requesterRole', 'requesterId',
          'subject', 'category', 'description', 'status', 'urgency', 'createdAt', 'updatedAt', 'messages'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterRole == 'CUSTOMER'
        && request.resource.data.status == 'OPEN'
        && request.resource.data.urgency in ['NORMAL', 'HIGH', 'CRITICAL']
        && stringWithin(request.resource.data.requesterName, 120)
        && stringWithin(request.resource.data.subject, 160)
        && stringWithin(request.resource.data.category, 80)
        && stringWithin(request.resource.data.description, 4000)
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0
        && hasValidTimestamps();
      allow update: if isAdmin() || isWorker();
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker() || isDriver()) && hasValidTimestamps();
    }

    match /driverExpenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker() || isDriver()) && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // WAREHOUSE, CHECKPOINTS, BORDER CROSSINGS
    // ----------------------------------------------------

    match /warehouse/{warehouseId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /checkpoints/{checkpointId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /borderCrossings/{borderId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isWorker()) && hasValidTimestamps();
    }

    match /deliveryProofs/{proofId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isDriver() || isWorker()) && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // DISPATCHED TRIPS
    // ----------------------------------------------------
    
    match /trips/{tripId} {
      allow read: if isSignedIn() && (isAdmin() || isWorker() || (resource.data.driverId == request.auth.uid));
      allow create, delete: if isAdmin() && hasValidTimestamps();
      allow update: if (isAdmin() || isWorker() || (
        isDriver() && resource.data.driverId == request.auth.uid
      )) && hasValidTimestamps();
    }

    // ----------------------------------------------------
    // CARGO & SHIPMENTS
    // ----------------------------------------------------
    
    match /cargo/{cargoId} {
      allow read: if isSignedIn() && isActive() && (isAdmin() || isWorker());
      allow create, update: if isSignedIn() && isActive() && (isAdmin() || isWorker()) && hasValidTimestamps();
      allow delete: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn() && isActive() && (isAdmin() || isWorker() || isDriver()
        || (isCustomer() && resource.data.customerEmail == request.auth.token.email));
      allow create, update: if isSignedIn() && isActive() && (isAdmin() || isWorker()) && hasValidTimestamps();
      allow delete: if isAdmin();
    }

    match /publicTracking/{trackingNumber} {
      // Shipment tracking is served through the phone-verified server endpoint.
      allow get: if false;
      allow list: if false;
      allow create, update: if isSignedIn() && isActive()
        && (isAdmin() || isWorker() || isDriver())
        && isValidPublicTracking(trackingNumber);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // DOCUMENTS
    // ----------------------------------------------------
    
    match /documents/{documentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isWorker() ||
        resource.data.uploadedBy == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if isSignedIn() && isActive() && hasValidTimestamps();
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.uploadedBy == request.auth.uid
      );
    }

    // ----------------------------------------------------
    // NOTIFICATIONS
    // ----------------------------------------------------
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin() || isWorker();
    }

    // ----------------------------------------------------
    // ACTIVITY LOG (Operational audit trail)
    // ----------------------------------------------------

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isActive();
      allow update, delete: if false;
    }

    // ----------------------------------------------------
    // AUDIT LOG (Admin only view, append-only by system)
    // ----------------------------------------------------
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && hasValidTimestamps();
      allow update, delete: if false; // Immutable audit log
    }

    // ----------------------------------------------------
    // PUBLIC CONTACT REQUESTS
    // ----------------------------------------------------

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // SYSTEM SETTINGS & BRANDING (Public read, Admin write)
    // ----------------------------------------------------
    
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /workplacePermissions/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'staffCommands', 'driverCommands', 'adminCommands',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == userId
        && request.resource.data.userId == userId
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (!('staffCommands' in request.resource.data)
          || request.resource.data.staffCommands is list
          && request.resource.data.staffCommands.size() <= 64)
        && (!('driverCommands' in request.resource.data)
          || request.resource.data.driverCommands is list
          && request.resource.data.driverCommands.size() <= 64)
        && (!('adminCommands' in request.resource.data)
          || request.resource.data.adminCommands is list
          && request.resource.data.adminCommands.size() <= 64);
      allow delete: if isAdmin();
    }

    match /companySettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding/{brandingId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /countries/{countryId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    match /branches/{branchId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'code', 'country', 'city', 'address', 'phone',
          'email', 'notes', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'code', 'country', 'city', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == branchId
        && stringWithin(request.resource.data.name, 120)
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9-]{2,16}$')
        && stringWithin(request.resource.data.country, 80)
        && stringWithin(request.resource.data.city, 120)
        && request.resource.data.status in ['ACTIVE', 'INACTIVE']
        && (!('address' in request.resource.data)
          || request.resource.data.address is string && request.resource.data.address.size() <= 240)
        && (!('phone' in request.resource.data)
          || request.resource.data.phone is string && request.resource.data.phone.size() <= 40)
        && (!('email' in request.resource.data)
          || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('notes' in request.resource.data)
          || request.resource.data.notes is string && request.resource.data.notes.size() <= 1000)
        && (!('createdBy' in request.resource.data)
          || request.resource.data.createdBy is string)
        && hasValidTimestamps();
      allow delete: if false;
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidTimestamps();
    }

    // Connection validation test document
    match /test/{testId} {
      allow read: if true;
    }
  }
}
